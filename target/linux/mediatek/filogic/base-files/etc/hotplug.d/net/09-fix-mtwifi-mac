#!/bin/sh
. /lib/functions.sh
. /lib/functions/system.sh

force_set_mac_to_dat()
{
    local dat="$1"
    local mac="$2"
    local field="${3:-MacAddress}"
    [ -f "$dat" ] || return
    [ -n "$mac" ] || return
    chmod 644 "$dat"
    sed -i '/^'"$field"'=/d' "$dat"
    echo "$field=$mac" >> "$dat"
}

set_macs_to_dat()
{
    local b0_mac="$1"
    local b1_mac="$2"
    local b0_dat="$(l1util if2dat ra0)"
    local b1_dat="$(l1util if2dat rax0)"
    if [ -f "$b0_dat" ]; then
        local mac="$(sed -n 's/^MacAddress=//p' "$b0_dat")"
        if [ -z "$(macaddr_canonicalize "$mac")" ]; then
            sed -i "s/^MacAddress=.*/MacAddress=$b0_mac/" "$b0_dat"
            grep -q "^MacAddress=" "$b0_dat" || echo "MacAddress=$b0_mac" >> "$b0_dat"
        fi
    fi
    if [ -f "$b1_dat" ]; then
        local mac="$(sed -n 's/^MacAddress=//p' "$b1_dat")"
        if [ -z "$(macaddr_canonicalize "$mac")" ]; then
            sed -i "s/^MacAddress=.*/MacAddress=$b1_mac/" "$b1_dat"
            grep -q "^MacAddress=" "$b1_dat" || echo "MacAddress=$b1_mac" >> "$b1_dat"
        fi
    fi
}

mtwifi_set_macs()
{
    case $(board_name) in
    acer,predator-w6)
        local mac_2g mac_5g mac_6g mac_boot
        mac_2g="$(fw_printenv -n 2gMAC)"
        mac_5g="$(fw_printenv -n 5gMAC)"
        mac_6g="$(fw_printenv -n 6gMAC)"
        # ra0 是 MT7986 DBDC 初始化接口，用 LAA 地址避免冲突
        mac_boot="$(macaddr_setbit_la "$mac_2g")"
        # 写入原始 dat 文件（驱动合并前的源文件）
        force_set_mac_to_dat \
            "/etc/wireless/mediatek/mt7986-ax7800.dbdc.b0.dat" \
            "$mac_boot"
        force_set_mac_to_dat \
            "/etc/wireless/mediatek/mt7986-ax7800.dbdc.b1.dat" \
            "$mac_5g"
        force_set_mac_to_dat \
            "/etc/wireless/mediatek/mt7916-ax7800.dbdc.b0.dat" \
            "$mac_2g"
        force_set_mac_to_dat \
            "/etc/wireless/mediatek/mt7916-ax7800.dbdc.b1.dat" \
            "$mac_6g"
        # 同时写入驱动合并文件 DBDC_card1.dat（MT7916）
        local dbdc1="/etc/wireless/mediatek/DBDC_card1.dat"
        force_set_mac_to_dat "$dbdc1" "$mac_2g" "MacAddress"
        force_set_mac_to_dat "$dbdc1" "$mac_6g" "MacAddress1"
        # bounce MT7916 让驱动重新读取 MAC
        ifconfig rai0 down
        ifconfig ray0 down
        ifconfig rai0 up
        ifconfig ray0 up
        ;;
    acer,predator-w6x-stock|\
    acer,predator-w6x-ubootmod)
        local base_mac="$(mtd_get_mac_ascii u-boot-env ethaddr)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    cudy,ap3000outdoor-v1|\
    cudy,ap3000-v1|\
    cudy,m3000-v1|\
    cudy,re3000-v1|\
    cudy,tr3000-256mb-v1|\
    cudy,tr3000-v1|\
    cudy,tr3000-v1-ubootmod|\
    cudy,tr3000-v1-mtkuboot|\
    cudy,wbr3000uax-v1|\
    cudy,wbr3000uax-v1-ubootmod|\
    cudy,wr3000e-v1|\
    cudy,wr3000s-v1|\
    cudy,wr3000h-v1|\
    cudy,wr3000p-v1|\
    cudy,wr3000-v1)
        local b0_mac="$(mtd_get_mac_binary bdinfo 0xde00)"
        local b1_mac="$(macaddr_setbit_la $(macaddr_add $b0_mac 1))"
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    h3c,magic-nx30-pro|\
    h3c,magic-nx30-pro-mtkuboot)
        local base_mac="$(mtd_get_mac_ascii pdt_data_1 ethaddr)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    qihoo,360t7)
        local base_mac="$(mtd_get_mac_ascii factory lanMac)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    ruijie,rg-x30e-pro|\
    ruijie,rg-x60-new-mtkuboot)
        local base_mac="$(mtd_get_mac_ascii product_info ethaddr)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    ruijie,rg-x60-new-ubi)
        local voldev="/dev/$(grep -l "product_info" /sys/class/ubi/ubi0_*/name | cut -d/ -f5)"
        local base_mac="$(strings $voldev | grep "^ethaddr=" | cut -d'=' -f2)"
        local b0_mac="$(macaddr_add $base_mac 2)"
        local b1_mac="$(macaddr_add $base_mac 3)"
        
        set_macs_to_dat "$b0_mac" "$b1_mac"
        ;;
    esac
}

[ "${ACTION}" = "add" ] && {
    case "${INTERFACE}" in
        ra0|rax0)
            mtwifi_set_macs
            ;;
    esac
}
