#!/bin/sh
+# uci-defaults hook that runs once after first boot on Acer Predator W6.
+#
+# The previous version tried to set wireless.default_radio{0..3}.path, but
+# those UCI sections never exist: mtwifi-cfg-ucode (mtwifi.uc) creates
+# wifi-device sections named after the l1profile devnames (MT7986_1_2,
+# MT7916_1_1, MT7916_1_2, ...) and the mtwifi netifd proto does not consume
+# a "path" option, so that block was dead code and has been removed.
+#
+# The /tmp run-once flag written by the hotplug script 10-fix-mtwifi-mac-w6
+# lives on tmpfs and is cleared by every reboot on its own; no action is
+# needed here.
. /lib/functions.sh

[ "$(board_name)" = "acer,predator-w6" ] || exit 0

exit 0
